# Gemini Flash writes the brief (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: override the model, e.g. a newer Flash release
GEMINI_MODEL=gemini-3.8-flash
# Optional: live fixtures from CricketData.org (https://cricketdata.org)
CRICAPI_KEY=
# Optional backup: Cricbuzz via RapidAPI (free BASIC plan, 200 requests/month)
RAPIDAPI_KEY=
# Telegram delivery: @Thirdmanviewbot token (from BotFather); optional fixed chat ids
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Backup gateway for Gemini (google/ models only) when the direct key hits limits
OPENROUTER_API_KEY=
# Neon Postgres: shared API cache + history of reports sent to Telegram (optional)
DATABASE_URL=
